{
  "_comment": "Sealed Arena — Restrictive seccomp profile for all zone containers. Default action is DENY (SCMP_ACT_ERRNO). Only syscalls required for Python runtime and network I/O are allowed. Dangerous syscalls (mount, ptrace, reboot, etc.) are explicitly blocked even if the default changes.",
  "defaultAction": "SCMP_ACT_ERRNO",
  "defaultErrnoRet": 1,
  "archMap": [
    {
      "architecture": "SCMP_ARCH_X86_64",
      "subArchitectures": [
        "SCMP_ARCH_X86",
        "SCMP_ARCH_X32"
      ]
    },
    {
      "architecture": "SCMP_ARCH_AARCH64",
      "subArchitectures": []
    }
  ],
  "syscalls": [
    {
      "_comment": "Core process lifecycle",
      "names": [
        "exit",
        "exit_group",
        "set_tid_address",
        "set_robust_list",
        "get_robust_list",
        "getpid",
        "getppid",
        "gettid",
        "getuid",
        "geteuid",
        "getgid",
        "getegid",
        "getgroups",
        "getresuid",
        "getresgid",
        "sched_getaffinity",
        "sched_yield",
        "nanosleep",
        "clock_nanosleep",
        "restart_syscall"
      ],
      "action": "SCMP_ACT_ALLOW"
    },
    {
      "_comment": "Memory management",
      "names": [
        "brk",
        "mmap",
        "munmap",
        "mprotect",
        "mremap",
        "madvise",
        "mbind",
        "set_mempolicy",
        "get_mempolicy",
        "mincore"
      ],
      "action": "SCMP_ACT_ALLOW"
    },
    {
      "_comment": "File I/O (read/write/open/close — needed for Python runtime)",
      "names": [
        "read",
        "write",
        "readv",
        "writev",
        "pread64",
        "pwrite64",
        "open",
        "openat",
        "close",
        "fstat",
        "newfstatat",
        "stat",
        "lstat",
        "lseek",
        "access",
        "faccessat",
        "faccessat2",
        "getcwd",
        "readlink",
        "readlinkat",
        "dup",
        "dup2",
        "dup3",
        "fcntl",
        "flock",
        "fsync",
        "fdatasync",
        "ftruncate",
        "truncate",
        "getdents",
        "getdents64",
        "unlink",
        "unlinkat",
        "rename",
        "renameat",
        "renameat2",
        "mkdir",
        "mkdirat",
        "rmdir",
        "symlink",
        "symlinkat",
        "link",
        "linkat",
        "chmod",
        "fchmod",
        "fchmodat",
        "chown",
        "fchown",
        "fchownat",
        "umask",
        "statfs",
        "fstatfs",
        "statx",
        "utime",
        "utimes",
        "utimensat"
      ],
      "action": "SCMP_ACT_ALLOW"
    },
    {
      "_comment": "Networking (TCP/UDP — needed for HTTP to Referee)",
      "names": [
        "socket",
        "socketpair",
        "connect",
        "accept",
        "accept4",
        "bind",
        "listen",
        "sendto",
        "sendmsg",
        "recvfrom",
        "recvmsg",
        "shutdown",
        "getsockname",
        "getpeername",
        "setsockopt",
        "getsockopt",
        "select",
        "pselect6",
        "poll",
        "ppoll",
        "epoll_create",
        "epoll_create1",
        "epoll_ctl",
        "epoll_wait",
        "epoll_pwait",
        "epoll_pwait2",
        "eventfd",
        "eventfd2"
      ],
      "action": "SCMP_ACT_ALLOW"
    },
    {
      "_comment": "Signal handling",
      "names": [
        "rt_sigaction",
        "rt_sigprocmask",
        "rt_sigreturn",
        "rt_sigpending",
        "rt_sigtimedwait",
        "rt_sigqueueinfo",
        "rt_tgsigqueueinfo",
        "sigaltstack",
        "kill",
        "tgkill",
        "tkill"
      ],
      "action": "SCMP_ACT_ALLOW"
    },
    {
      "_comment": "Threading and futex (needed for Python threading/asyncio)",
      "names": [
        "clone",
        "clone3",
        "futex",
        "futex_waitv",
        "wait4",
        "waitid",
        "pipe",
        "pipe2"
      ],
      "action": "SCMP_ACT_ALLOW"
    },
    {
      "_comment": "Time and clock (needed for timestamps and timing shaping)",
      "names": [
        "clock_gettime",
        "clock_getres",
        "gettimeofday",
        "time"
      ],
      "action": "SCMP_ACT_ALLOW"
    },
    {
      "_comment": "Misc required for Python runtime",
      "names": [
        "arch_prctl",
        "prctl",
        "getrandom",
        "ioctl",
        "uname",
        "sysinfo",
        "rseq",
        "prlimit64"
      ],
      "action": "SCMP_ACT_ALLOW"
    },
    {
      "_comment": "EXPLICITLY DENIED — Dangerous syscalls that must never be allowed",
      "names": [
        "mount",
        "umount",
        "umount2",
        "pivot_root",
        "chroot",
        "ptrace",
        "process_vm_readv",
        "process_vm_writev",
        "reboot",
        "kexec_load",
        "kexec_file_load",
        "init_module",
        "finit_module",
        "delete_module",
        "create_module",
        "acct",
        "swapon",
        "swapoff",
        "nfsservctl",
        "personality",
        "unshare",
        "setns",
        "kcmp",
        "userfaultfd",
        "bpf",
        "perf_event_open",
        "lookup_dcookie",
        "keyctl",
        "add_key",
        "request_key",
        "move_pages",
        "migrate_pages",
        "io_setup",
        "io_destroy",
        "io_submit",
        "io_cancel",
        "io_getevents",
        "io_uring_setup",
        "io_uring_enter",
        "io_uring_register"
      ],
      "action": "SCMP_ACT_ERRNO",
      "errnoRet": 1
    }
  ]
}
